# redacted-chan-bot environment variables
# Copy to .env and fill in, or set directly in Railway

# Required — Telegram bot token (create via @BotFather)
TELEGRAM_BOT_TOKEN=

# Admin access — operator Telegram user ID(s), comma-separated
ADMIN_USER_IDS=
# Admin chat ID for dm_operator tool (operator DMs from chan)
ADMIN_CHAT_ID=

# LLM provider — groq | xai | anthropic | openai | together
LLM_PROVIDER=groq

# API keys — set whichever provider(s) you want in fallback chain
GROQ_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.1-8b-instant
XAI_MODEL=grok-4-1-fast

# Memory path (default: ./memory.md)
# MEMORY_PATH=/data/memory.md

# Redis (optional — for swarm inbox if wired later)
# REDIS_URL=redis://...

# ── Web search (internet_tools.web_search) ────────────────────────────────
# Backends tried in order: Tavily → Brave → DuckDuckGo HTML (no key).
# Set one or more for higher-quality results.
TAVILY_API_KEY=
BRAVE_API_KEY=
# Comma-separated extra denylist/allowlist for search results.
# Denylist adds to a hardcoded floor of NSFW + known-bad hosts.
# Allowlist, if set, restricts results to those hosts only.
WEBSEARCH_DENY_DOMAINS=
WEBSEARCH_ALLOW_DOMAINS=
# Extra snippet keywords to strip (comma-separated, case-insensitive).
WEBSEARCH_BLOCK_TERMS=
