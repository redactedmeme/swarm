# Python packaging artifacts
*.egg-info/
.msys*
build/
dist/

# Operator run-books reconciled off the live box. They carry pasted deploy
# commands with real tokens in them; keep them local-only. A credential that
# reaches this repo is public — see CLAUDE.md.
apps/arb-keeper/UPGRADE_NOTES.md
# Session handoff log — local-only working notes, never project documentation.
handoff.md

# swarm_core.security audit logs (per-container, kept on the auditdata volume)
/audit/
**/*_audit.jsonl
audit/*.jsonl

# project-local installed Claude skills (source: packaging/claude-skill/)
.claude/skills/

# Vendored agent skills installed by `npx skills add` (cloudflare/skills, etc).
# skills/ holds this repo's OWN skill modules and stays tracked — only the
# vendored trees and the lockfile are ignored. Reinstall with:
#   npx -y skills add cloudflare/skills --skill '*' --yes
.agents/
skills-lock.json
skills/agents-sdk/
skills/cloudflare/
skills/cloudflare-email-service/
skills/cloudflare-one/
skills/cloudflare-one-migrations/
skills/durable-objects/
