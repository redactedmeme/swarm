# ── Runtime / generated state (not source) ────────────────────────────────────
# NOTE: git does not support inline (end-of-line) comments in .gitignore — each
# comment must be on its own line, or it becomes part of the pattern and breaks it.
# Qdrant vector store + mem0 SQLite (large, machine-local)
fs/memories/
# Ephemeral session JSON (python/session_store.py, web UI)
fs/sessions/
# File inbox between agents (swarm_inbox, hermes, smolting)
fs/swarm_messages/
# Auto-generated repo scan index
fs/gnosis_repo_index.json
# Auto-generated docs ingest index
fs/docs_index.json
# hermes_delegation_executor / clawtask aggregator output
fs/clawtask_dispatch_results.json
# Live Pattern Blue cycle state (dashboard, executor)
fs/pattern_blue_state.json
# Hyperbolic kernel ticks (kernel_seed, phi_compute)
fs/kernel_state.json

# Same runtime layout when smolting uses ./fs (Railway rootDirectory = smolting-telegram-bot/)
apps/smolting/fs/swarm_messages/
apps/smolting/fs/clawtask_dispatch_results.json
apps/smolting/fs/pattern_blue_state.json
apps/smolting/fs/kernel_state.json
apps/smolting/fs/*.db
apps/smolting/fs/*.jsonl

# swarm-agent-base runtime state (activity log + seeded SOUL.md copies)
apps/degen/fs/
apps/govimprover/fs/
fs/*_memory.jsonl

# Runtime logs (contain internal hostnames / operational data — not for public repo)
fs/logs/
fs/manifold_submissions.log

