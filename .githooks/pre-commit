#!/usr/bin/env sh
# Refuse a commit that stages credential-shaped material.
# The scan itself lives in scripts/secret_scan.py so CI runs the same rules.
# Emergency bypass:  SWARM_SKIP_SECRET_SCAN=1 git commit ...
[ "$SWARM_SKIP_SECRET_SCAN" = "1" ] && exit 0

if command -v python3 >/dev/null 2>&1; then PY=python3
elif command -v python  >/dev/null 2>&1; then PY=python
else
  echo "pre-commit: no python on PATH; cannot scan for secrets." >&2
  echo "            install python, or bypass with SWARM_SKIP_SECRET_SCAN=1" >&2
  exit 1
fi
exec "$PY" "$(git rev-parse --show-toplevel)/scripts/secret_scan.py" --staged
