# Bankr Wallet — environment variables
# Copy relevant vars into Railway (or .env for local dev)
# NEVER commit a file with real values

# Required — generate at bankr.bot/api
# Use a DEDICATED agent key (not your personal Bankr account key)
BANKR_API_KEY=your_bankr_api_key_here

# Optional — override Bankr API base URL (default: https://api.bankr.bot)
# BANKR_BASE_URL=https://api.bankr.bot
