# Veil Privacy — environment variables
# Set in Railway for smolting-telegram-bot
# NEVER commit real values

# Required — your Veil private key (hex, 32 bytes)
# Generate: connect wallet at veil.cash → Key Management → export private key
# OR derive deterministically from EOA signature via Veil UI
VEIL_PRIVATE_KEY=your_veil_private_key_hex_here

# Required — Bankr API key (already set if bankr-wallet is configured)
# BANKR_API_KEY=bk_usr_...

# Optional — Base RPC (public endpoint used if not set)
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
