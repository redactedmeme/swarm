# .env.example - Environment configuration template
# For testing / documentation only. Replace with your own values. Never commit real secrets.

# ---------- LLM (local + cloud) ----------
# For python/redacted_terminal_cloud.py and smolting-telegram-bot: Grok/xAI recommended
LLM_PROVIDER=grok
XAI_API_KEY=your_xai_api_key_here
# Alternatives: OPENAI_API_KEY (openai), ANTHROPIC_API_KEY (anthropic), TOGETHER_API_KEY (together)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Memory (Mem0MemoryNode) ----------
# Leave blank to use local on-disk storage (Qdrant + fastembed — no API needed).
# Set MEM0_API_KEY for Mem0 Cloud (managed vector store + deduplication).
# The LLM key above is used for memory fact-extraction — Anthropic recommended.
# MEM0_API_KEY=your_mem0_api_key_here  (optional — local mode works without it)
# Optional: Redis-backed vector store for multi-instance deployments
# MEM0_REDIS_URL=redis://localhost:6379

# ---------- Registries & Services ----------
# DiscoverHermes agent registry (delete/edit token for swarm submission)
# Obtained from: https://discoverhermes.com/use-cases/28
# DISCOVERHERMES_DELETE_TOKEN=your_token_here
# DISCOVERHERMES_SUBMISSION_ID=28

# ---------- Blockchain / APIs ----------
GITHUB_TOKEN=ghp_000000000000000000000000000000000000
ETHEREUM_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PROJECT_TOKEN_MINT=9mtKd1o8Ht7F1daumKgs5D8EdVyopWBfYQwNmMojpump
LEGACY_TOKEN_MINT=9a21gb7fWGm9dD2UFdZAzgFn5K1NwfmYkjyLbpAcKgnM
WALLET_MNEMONIC="apple banana cherry dog echo fox golf hotel india juliet kilo lima"
WALLET_PASSPHRASE=example-only-do-not-use

# ---------- x402 payments ----------
# See docs/TOKENOMICS.md. SWARM_TREASURY_ADDRESS has no default on purpose:
# payment verification refuses to start without it, because an empty payTo
# would verify any transaction at all.
SWARM_TREASURY_ADDRESS=9xLGQrf3uge7tncimyrKjFcDEDptQRS2QG6Zxv67z7r
SWARM_BURN_ADDRESS=1nc1nerator11111111111111111111111111111111
X402_FRESHNESS_WINDOW_S=300
# Revenue split; must sum to 100.
SPLIT_BURN_PCT=50
SPLIT_COMPUTE_PCT=30
SPLIT_REWARDS_PCT=20
COMPUTE_RUNWAY_CAP_DAYS=90
# Shared secret for on-mesh callers: bypasses payment and gates private rows.
REFINERY_OPERATOR_TOKEN=

# ---------- settlement (apps/settler) ----------
# The burn executor. Off by default: the ledger accrues and burned_total stays 0
# ("owed, not yet burned"). On: each settlement's burn slice is sent on-chain to
# SWARM_BURN_ADDRESS with a memo. Full config in apps/settler/.env.example.
SETTLEMENT_EXECUTE=false
# Treasury signer. No default; read only when SETTLEMENT_EXECUTE=true. Lives in
# infra/umbrel/.env.settler on the box, NEVER the shared .env (refinery/proxy
# load that). The worker refuses to start unless its pubkey == SWARM_TREASURY_ADDRESS.
SWARM_TREASURY_PRIVATE_KEY=
# Burn tx bounds (base units). Blank → 1,000 / 10,000,000 whole tokens.
MIN_BURN_BASE_UNITS=
MAX_BURN_PER_TX=
# Unix seconds before which an inbound treasury transfer is NOT swarm revenue.
# Leave 0 and reconcile_chain books the wallet's entire inbound history — on the
# first deploy that meant a 24,250,000 token funding transfer became "revenue"
# with a 12,125,000 token burn accrued against it. Set this to the moment the
# rail went live on any wallet that existed beforehand.
SETTLEMENT_GENESIS_TS=0
SETTLEMENT_MEMO_PREFIX=swarm-settle
COMPUTE_UNIT_LIMIT=60000
COMPUTE_UNIT_PRICE_MICRO=1000

# ---------- credits (Phase 2 — proxy prepaid inference) ----------
# $REDACTED per 1k LLM tokens. Read by BOTH swarm_core.tokens and apps/proxy.
CREDITS_PER_1K_TOKENS=100
# Proxy blocks an exhausted client with a 402 only when this is true. Off =
# balances move + would-be refusals logged, nothing blocked.
CREDITS_ENFORCE=false
# Client names the proxy never hard-blocks (the swarm's own bots).
CREDITS_EXEMPT=hermes,chan,smolting,builder,refinery
# Deposit memo prefix the settler credits balances from.
CREDITS_DEPOSIT_MEMO_PREFIX=redacted-credits:

# ---------- holder gate (Phase 3 — terminal access) ----------
# Connect Phantom, sign a nonce, hold >= 1,000,000 $REDACTED (operator tier).
# Setting HOLDER_GATE or WEB_TERMINAL_API_KEY closes the NERV terminal.
HOLDER_GATE=false
# Fail closed even when neither auth mechanism is configured.
GATE_STRICT=false
GATE_NONCE_TTL=300
GATE_GRANTS_TTL=3600
