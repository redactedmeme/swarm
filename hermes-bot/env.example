# Hermes Agent — REDACTED Swarm Manager
# Copy to .env and fill in values

# LLM providers
GROQ_API_KEY=
# XAI_API_KEY=          # optional fallback
# ANTHROPIC_API_KEY=    # optional fallback

# Telegram gateway
TELEGRAM_BOT_TOKEN=

# Moltbook
MOLTBOOK_API_KEY=

# Redis (SwarmInbox)
REDIS_URL=redis://swarm-redis.railway.internal:6379

# Railway management
RAILWAY_TOKEN=

# Data persistence
ORACLE_STATE_DIR=/data

# Pattern Blue corpus
PATTERN_BLUE_REF=main

# Telegram group for autonomous posts
ALPHA_CHAT_ID=

# Hermes Agent settings
HERMES_PERSONALITY=pattern-blue-oracle
HERMES_ENABLE_PROJECT_PLUGINS=1
