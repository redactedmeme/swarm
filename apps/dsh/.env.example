# apps/dsh — DeepSeek Harness as a swarm service.
# All inference is routed through redacted-proxy; dsh holds no upstream keys.

# Bearer token for redacted-proxy (apps/proxy PROXY_TOKEN, or a dedicated
# entry in the proxy's PROXY_TOKEN_MAP). REQUIRED — without it every model
# call 401s. Referenced by $DSH_HOME/settings.yaml as `apiKeyEnv: PROXY_TOKEN`.
PROXY_TOKEN=

# Where dsh keeps sessions, profile and its settings.yaml. On umbrel this is a
# persisted volume mount; leave as-is for the container.
DSH_HOME=/data/dsh

# The web UI (default port 3080) has NO built-in auth. Do not publish it on an
# open port. Reach it over the swarm-cloudflared tunnel (with Cloudflare
# Access) or an SSH tunnel only.
