
# ── Push to the public mirror ─────────────────────────────────────────────────
# This node has no inbound route from the internet, so the feed is pushed rather
# than pulled. Both must be set for the loop to run; the token is shared with
# the website's STATUS_PUSH_TOKEN.
STATUS_PUSH_URL=https://redacted.meme/api/swarm/publish
STATUS_PUSH_TOKEN=
STATUS_PUSH_INTERVAL=60
