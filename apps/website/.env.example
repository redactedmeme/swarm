
# ── Pushed status feed ────────────────────────────────────────────────────────
# Shared secret apps/status presents on POST /api/swarm/publish. Unset disables
# publishing (404) rather than accepting an unauthenticated payload.
STATUS_PUSH_TOKEN=
# Discard a pushed payload older than this many seconds, so a dead feed renders
# as absent rather than as permanently "online".
STATUS_MAX_AGE=300
