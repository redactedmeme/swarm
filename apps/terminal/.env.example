# NERV web terminal (terminal.redacted.meme). Runs from the repo root so the
# image can install packages/swarm-core.

# ── Access ───────────────────────────────────────────────────────────────
# A static bearer token. If set, the terminal is closed and a client must
# present ?token=<this> on the socket.
WEB_TERMINAL_API_KEY=
FLASK_SECRET_KEY=

# $REDACTED holder gate: connect Phantom, sign a server nonce, and hold at
# least the operator threshold (1,000,000 $REDACTED) — see swarm_core.tokens.TIERS.
# Setting this OR WEB_TERMINAL_API_KEY closes the terminal.
HOLDER_GATE=false
# Fail closed (503) even when neither auth mechanism is configured. Otherwise
# an unconfigured terminal stays open and logs a loud warning.
GATE_STRICT=false
# Nonce and grant-cache lifetimes (seconds).
GATE_NONCE_TTL=300
GATE_GRANTS_TTL=3600

# Redis holds the gate nonces and the gate:grants:<wallet> mirror.
REDIS_URL=redis://127.0.0.1:6379

# RPC for the on-chain balance read (Helius if HELIUS_API_KEY is set).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
PROJECT_TOKEN_MINT=9mtKd1o8Ht7F1daumKgs5D8EdVyopWBfYQwNmMojpump

# ── Runtime ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
RUNTIME_API_URL=http://localhost:4001
WEB_RATE_LIMIT=10
WEB_RATE_LIMIT_WINDOW=60

# ── Holder-gated alpha feed ───────────────────────────────────────────────────
# Shared secret smolting presents on POST /api/alpha/publish. Unset disables
# publishing (the endpoint 404s) rather than accepting unauthenticated reports.
ALPHA_PUBLISH_TOKEN=
