# redacted-proxy — see README.md "Environment variables" for the full list.
# On the box these live in the shared infra/umbrel/.env (env_file).

# ── Auth / attribution ───────────────────────────────────────────────────
PROXY_TOKEN=change-me
# JSON {"<bearer>": "<project>"} — per-project tokens that authenticate AND attribute.
PROXY_TOKEN_MAP=
PROXY_TOKEN_NAME=shared
ADMIN_TOKEN=
RATE_LIMIT_RPM=60

# ── Upstream provider keys (set the ones you use) ────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
VENICE_API_KEY=

# ── Infra ────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
PORT=7080
PRIVACY_MODE=private
UPSTREAM_PROXY=

# ── Usage accounting ─────────────────────────────────────────────────────
USAGE_ENABLED=true
USAGE_PREFIX=proxy:usage:
USAGE_DAILY_TTL_DAYS=90

# ── $REDACTED credits (Phase 2) ─────────────────────────────────────────
# Price per 1k LLM tokens, in whole $REDACTED. SAME env var name as
# swarm_core.tokens.CREDITS_PER_1K_TOKENS — set one value on the box and the
# proxy (debits) and settler (settles) stay in step.
CREDITS_PER_1K_TOKENS=100
# Off by default: balances still move and would-be refusals are logged, but no
# request is blocked. Flip on once real deposits are landing.
CREDITS_ENFORCE=false
# Comma-separated client names never hard-blocked (the swarm's own bots). They
# still debit — their negative balance is what the swarm owes its own compute
# treasury.
CREDITS_EXEMPT=hermes,chan,smolting,builder,refinery
# Shown in the 402 body. Deposits are $REDACTED transfers to the treasury with
# an SPL Memo "redacted-credits:<client>"; apps/settler credits the balance.
CREDITS_TOPUP_HINT=
