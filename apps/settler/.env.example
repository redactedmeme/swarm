# swarm-settler — settlement ledger + on-chain burn executor.
# On the umbrel box this is `.env.settler` (git-ignored), NOT the shared `.env`
# that refinery/proxy load — the treasury key must not reach those containers.

# ── Redis (host networking on the box) ────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Token identity (kept in step with packages/swarm-core) ────────────────
PROJECT_TOKEN_MINT=9mtKd1o8Ht7F1daumKgs5D8EdVyopWBfYQwNmMojpump
SWARM_TREASURY_ADDRESS=9xLGQrf3uge7tncimyrKjFcDEDptQRS2QG6Zxv67z7r
SWARM_BURN_ADDRESS=1nc1nerator11111111111111111111111111111111
SPLIT_BURN_PCT=50
SPLIT_COMPUTE_PCT=30
SPLIT_REWARDS_PCT=20
COMPUTE_RUNWAY_CAP_DAYS=90

# ── On-chain execution ───────────────────────────────────────────────────
# Master switch. Off (default): ledger accrues, nothing is signed, the key
# below is not read. On: every settlement's burn slice is sent to the
# incinerator with a memo.
SETTLEMENT_EXECUTE=false
# 64-byte base58 export, 32-byte seed, or a JSON int array. No default. Read
# only when SETTLEMENT_EXECUTE=true; the worker refuses to start unless its
# public key equals SWARM_TREASURY_ADDRESS.
SWARM_TREASURY_PRIVATE_KEY=

# RPC — Helius when a key is set, else SOLANA_RPC_URL.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Burn tuning ──────────────────────────────────────────────────────────
# Floor: don't send a burn tx for less than this many base units (each costs a
# priority fee). Default 1,000 whole tokens.
MIN_BURN_BASE_UNITS=
# Ceiling per tx; the remainder stays owed for the next round. Default 10,000,000 tokens.
MAX_BURN_PER_TX=
COMPUTE_UNIT_LIMIT=60000
COMPUTE_UNIT_PRICE_MICRO=1000
# Consecutive burn failures before the worker halts (set burn_halted=""/
# burn_fail_streak=0 in the hash to resume).
BURN_FAIL_STREAK_MAX=5
# Below this the treasury can't pay tx fees — burns defer with a log line.
MIN_TREASURY_SOL=0.01
SETTLEMENT_MEMO_PREFIX=swarm-settle
SETTLER_POLL_S=20
SETTLER_METRICS_EVERY_S=300

# ── Runway metric (optional) ─────────────────────────────────────────────
# When set, the worker sums the proxy's trailing-30d cost_usd for the
# SWARM RUNWAY figure. Left blank, runway_days is simply not published.
PROXY_URL=
PROXY_TOKEN=

# ── Credits (Phase 2) ────────────────────────────────────────────────────
# The worker also: credits credits:balance:<client> for treasury deposits whose
# SPL Memo starts with this prefix, and drains credits:spend:queue (the proxy's
# per-request debits) into burn-split settlements. Runs regardless of
# SETTLEMENT_EXECUTE — no key needed.
CREDITS_DEPOSIT_MEMO_PREFIX=redacted-credits:
