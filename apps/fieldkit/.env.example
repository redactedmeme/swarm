# Field Kit — all optional. With none set, the app runs read-only:
# live mesh/roster/token data still load from public endpoints, and the
# Chamber / DharmaNode pages serve their local deterministic fallback.

# redacted-proxy (OpenAI-compatible). Set BOTH to enable live Chamber
# deliberation and DharmaNode inference. Same convention as apps/refinery.
PROXY_URL=
PROXY_TOKEN=
# Optional model override; defaults to the proxy's "auto" router.
PROXY_MODEL=auto
