# RedactedGovImprover — copy to infra/umbrel/.env.govimprover on the box

# ── Mesh / infra ────────────────────────────────────────────────────────────
REDIS_URL=redis://:REDACTED@127.0.0.1:6379
SWARM_NODE_ID=redactedgovimprover
SWARM_INBOX_HMAC_KEY=REDACTED            # shared swarm key (already on the box)
SWARM_INBOX_ENFORCE=warn
SWARM_AUDIT_LOG=/audit/govimprover.jsonl
PYTHONUNBUFFERED=1

# ── LLM (free-first cascade via the proxy auto-router) ──────────────────────
PROXY_URL=http://127.0.0.1:7080
PROXY_TOKEN=REDACTED
PROXY_MODEL=auto

# ── Mesh thought exchange ──────────────────────────────────────────────────
SWARM_THOUGHT_PEERS=smolting,redacted-chan
SWARM_THOUGHT_INTERVAL_H=7

# ── Governance digest + posting (full autonomy, DRAFT ONLY) ───────────────
GOV_DIGEST_INTERVAL_SEC=1800
GOV_POST_ENABLED=true
GOV_POST_MIN_SEC=7200            # 2 h
GOV_POST_MAX_SEC=14400           # 4 h
GOV_TG_BOT_TOKEN=               # optional — unset => log-only posts
GOV_TG_CHAT_ID=
