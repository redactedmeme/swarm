# RedactedDegen — copy to infra/umbrel/.env.degen on the box

# ── Mesh / infra ────────────────────────────────────────────────────────────
REDIS_URL=redis://:REDACTED@127.0.0.1:6379
SWARM_NODE_ID=degen
SWARM_INBOX_HMAC_KEY=REDACTED            # shared swarm key (already on the box)
SWARM_INBOX_ENFORCE=warn
SWARM_AUDIT_LOG=/audit/degen.jsonl
PYTHONUNBUFFERED=1

# ── LLM (free-first cascade via the proxy auto-router) ──────────────────────
PROXY_URL=http://127.0.0.1:7080
PROXY_TOKEN=REDACTED
PROXY_MODEL=auto

# ── Mesh thought exchange ──────────────────────────────────────────────────
SWARM_THOUGHT_PEERS=smolting,redactedbuilder
SWARM_THOUGHT_INTERVAL_H=7

# ── Pool monitor ───────────────────────────────────────────────────────────
POOL_MIN_LIQUIDITY=100000
POOL_MAX_RESULTS=10
POLL_INTERVAL_SECONDS=60
APR_SPIKE_THRESHOLD=50
IL_WARN_THRESHOLD=-5
IL_EXIT_THRESHOLD=-25

# ── Autonomous posting (full autonomy) ────────────────────────────────────
DEGEN_POST_ENABLED=true
DEGEN_POST_MIN_SEC=5400           # 90 min
DEGEN_POST_MAX_SEC=10800          # 180 min
DEGEN_TG_BOT_TOKEN=               # optional — unset => log-only posts
DEGEN_TG_CHAT_ID=

# State persistence (container path; Dockerfile defaults to /data/degen_state.json)
STATE_PATH=/data/degen_state.json
