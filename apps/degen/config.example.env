# RedactedDegen pool monitor — copy to .env for local dev

# Pool filtering
POOL_MIN_LIQUIDITY=100000       # USD — ignore pools below this
POOL_MAX_RESULTS=10             # max pools returned per source

# Alert thresholds
POLL_INTERVAL_SECONDS=60
APR_SPIKE_THRESHOLD=50          # % — signal swarm when APR exceeds this
IL_WARN_THRESHOLD=-5            # % — log IL warning below this
IL_EXIT_THRESHOLD=-25           # % — emit auto-exit signal below this

# Swarm integration
SWARM_WEBHOOK_URL=              # SwarmInbox webhook for capital signals

# State persistence (optional — defaults to fs/degen_state.json)
STATE_PATH=fs/degen_state.json
