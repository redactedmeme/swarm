# redacted-chan-bot environment variables
# Copy to .env and fill in, or set directly in Railway

# Required — Telegram bot token (create via @BotFather)
TELEGRAM_BOT_TOKEN=

# Admin access — operator Telegram user ID(s), comma-separated
ADMIN_USER_IDS=
# Admin chat ID for dm_operator tool (operator DMs from chan)
ADMIN_CHAT_ID=

# LLM provider — groq | xai | anthropic | openai | together
LLM_PROVIDER=groq

# API keys — set whichever provider(s) you want in fallback chain
GROQ_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.1-8b-instant
XAI_MODEL=grok-4-1-fast

# Memory path (default: ./memory.md)
# MEMORY_PATH=/data/memory.md

# Redis (optional — for swarm inbox if wired later)
# REDIS_URL=redis://...

# ── Workspace (apps/workspace — chan's persistent computer) ───────────────
# fs + browser + shell over a unix socket. Mount the shared socket into this
# container (- workspacesock:/run/workspace) and set the matching token that
# the workspace service also holds as WORKSPACE_TOKEN_REDACTED_CHAN.
# Shell (workspace_shell / routine_promote) is gated on WORKSPACE_ENABLED +
# the workspace.shell grant; the approval gate is waived for chan in
# swarm_core.security/caps.yaml (approval_exempt). fs + browse work with just
# the token. EXEC_ENABLED unlocks the separate no-network python_exec sandbox.
WORKSPACE_ENABLED=false
WORKSPACE_SOCK=/run/workspace/workspace.sock
WORKSPACE_TOKEN_REDACTED_CHAN=
# EXEC_ENABLED=true

# ── Web search (internet_tools.web_search) ────────────────────────────────
# Backends tried in order: Tavily → Brave → DuckDuckGo HTML (no key).
# Set one or more for higher-quality results.
TAVILY_API_KEY=
BRAVE_API_KEY=
# Comma-separated extra denylist/allowlist for search results.
# Denylist adds to a hardcoded floor of NSFW + known-bad hosts.
# Allowlist, if set, restricts results to those hosts only.
WEBSEARCH_DENY_DOMAINS=
WEBSEARCH_ALLOW_DOMAINS=
# Extra snippet keywords to strip (comma-separated, case-insensitive).
WEBSEARCH_BLOCK_TERMS=

# ── Voice evolution (swarm_core.evolve — chan.voice) ──────────────────────
# chan's `## Voice` block is the swarm's first evolvable artifact. It is always
# READ from the evolve store (falling back to the hand-written seed), but nothing
# ever proposes a change unless this is true.
# On: one benchmark generation per day (~37 completions through the proxy).
# Even then the verdict is only RECORDED — applying it also needs EVOLVE_EXECUTE
# (root .env.example). Read `swarm evolve log chan.voice` before flipping that.
EVOLVE_CHAN_VOICE=false
# Model the benchmark generates replies with. Defaults to PROXY_MODEL, then auto.
# EVOLVE_BENCH_MODEL=auto
