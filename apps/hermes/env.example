# Hermes Agent — REDACTED Swarm Manager
# Copy to .env and fill in values

# LLM providers
GROQ_API_KEY=
# XAI_API_KEY=          # optional fallback
# ANTHROPIC_API_KEY=    # optional fallback

# Telegram gateway
TELEGRAM_BOT_TOKEN=

# Moltbook
MOLTBOOK_API_KEY=

# Redis (SwarmInbox)
REDIS_URL=redis://localhost:6379

# Railway management API token (GraphQL access)
RAILWAY_API_TOKEN=

# Railway environment and service IDs (set these to enable railway_tools)
RAILWAY_ENV_ID=
RAILWAY_SERVICE_REDACTED_CHAN_BOT=
RAILWAY_SERVICE_SMOLTING_TELEGRAM_BOT=
RAILWAY_SERVICE_HERMES_BOT=
RAILWAY_SERVICE_SWARM_RUNTIME=
RAILWAY_SERVICE_REDACTEDBUILDER_BOT=
RAILWAY_SERVICE_REDACTED_WEBSITE=
RAILWAY_SERVICE_REDACTED_DASHBOARD=

# Data persistence
ORACLE_STATE_DIR=/data

# Pattern Blue corpus
PATTERN_BLUE_REF=main

# Telegram group for autonomous posts
ALPHA_CHAT_ID=

# Hermes Agent settings
HERMES_PERSONALITY=pattern-blue-oracle
HERMES_ENABLE_PROJECT_PLUGINS=1

# ── swarm-manager plugin: optional tool groups ───────────────────────────────
# web_fetch / web_search and skill_recall register unconditionally.

# X/Twitter tools register only when ALL four credentials resolve. The writes
# (x_post/x_reply/x_like) additionally require the `social.post` capability plus
# a live approval token (see swarm_core.security.caps.yaml).
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# python_exec — routed to apps/exec-runner over a unix socket (no secrets, no
# network in that container). Registration is OFF unless EXEC_ENABLED=true.
EXEC_ENABLED=false
EXEC_RUNNER_SOCK=/run/exec/exec.sock
EXEC_RUNNER_TOKEN=
