{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-u", "serve.py"],
      "port": 8080,
      "cwd": "apps/website",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-u", "apps/dashboard/serve.py"],
      "port": 3001,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "apps/dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "apps/dashboard"
    },
    {
      "name": "terminal-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "fs"],
      "port": 8765
    }
  ]
}
