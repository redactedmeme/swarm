{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-ui",
      "runtimeExecutable": "python",
      "runtimeArgs": ["web_ui/app.py"],
      "port": 8888
    },
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": ["website/serve.py"],
      "port": 8080
    },
    {
      "name": "x402-gateway",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "x402.redacted.ai/index.js"],
      "port": 3000
    },
    {
      "name": "terminal-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "fs"],
      "port": 8765
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-u", "dashboard/serve.py"],
      "port": 3001,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "webchat-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--host"],
      "port": 5173,
      "cwd": "webchat/frontend"
    }
  ]
}
